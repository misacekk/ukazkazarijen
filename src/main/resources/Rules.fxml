<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1000.0" prefWidth="1600.0"
            style="-fx-background-color: #0f0f12;"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.panacku.zlobse.RulesController">

    <!-- HORNÍ LIŠTA -->
    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #16161a; -fx-border-color: #2a2a30; -fx-border-width: 0 0 1 0;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15" right="35" bottom="15" left="35"/>
            </padding>
            <children>
                <Button text="← Zpět do Menu" onAction="#zpetDoMenu" prefHeight="42.0" prefWidth="145.0"
                        styleClass="btn-red-fantasy" style="-fx-font-size: 14px;" />
            </children>
        </HBox>
    </top>

    <!-- OBSAH PRAVIDEL -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0f0f12; -fx-background-color: #0f0f12; -fx-border-color: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 25px 60px;">
                    <children>

                        <!-- Titul -->
                        <Label text="PRAVIDLA HRY"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 28px; -fx-font-weight: bold; -fx-effect: dropshadow(three-pass-box, rgba(255,215,0,0.2), 10, 0, 0, 0);" />

                        <!-- KARTA PRAVIDEL V SVITKU -->
                        <StackPane maxWidth="850.0">
                            <children>
                                <!-- Obrázek pergamenu v pozadí -->
                                <ImageView fitWidth="850.0" fitHeight="540.0" preserveRatio="false" pickOnBounds="true">
                                    <image>
                                        <Image url="@images/paper.png" />
                                    </image>
                                </ImageView>

                                <!-- Text pravidel navrchu pergamenu -->
                                <VBox spacing="10.0" style="-fx-padding: 40px 50px 40px 50px;">
                                    <children>
                                        <Label text="1. PRAVIDLA A PODMÍNKY VÍTĚZSTVÍ" styleClass="scroll-title" style="-fx-font-size: 19px;" />
                                        <Label text="• Režimy hry: Podporuje herní režimy pro 2 hráče (1 vs 1), 3 hráče (1v1v1) i 4 hráče (1v1v1v1)." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Herní plán: Herní plán se skládá z herních políček, po kterých se figurky pohybují ve směru hodinových ručiček." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Startovní políčka: Každá třída hrdiny má určené své vlastní startovní / vyjížděcí políčko na desce." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Správa figurek: Každý hráč disponuje celkem 4 figurkami, které začínají v domovském spawnu." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Nasazení figurky: Pro vyjetí figurky na hrací desku musí hráč hodit hodnotu 6." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Výběr figurky: Po hodu kostkou si hráč interaktivně vybírá, se kterou ze svých dostupných figurek vykoná tah." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Obkroužení desky: Figurka musí ujet celé kolo, aby se dostala před vstup do domečku." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Vstup do domečku: Po dokončení celého okruhu stojí figurka před domečkem. Pro úspěšný vstup do domečku musí hráč v následujícím tahu hodit přesně hodnotu 1." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Vyhazování figurek: Pokud figurka vstoupí na políčko obsazené soupeřovou figurkou, soupeřova figurka je vyhozena a vrací se zpět do domovského spawnu (pokud nezasáhne pasivní schopnost hrdiny)." styleClass="scroll-text" style="-fx-font-size: 14px;" />
                                        <Label text="• Podmínka vítězství: Vítězí ten hráč, který jako první úspěšně dovede do domečku všechny 4 své figurky." style="-fx-text-fill: #196f27; -fx-font-size: 14px; -fx-font-weight: bold;" />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>