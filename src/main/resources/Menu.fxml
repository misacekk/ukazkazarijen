<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cz.panacku.zlobse.MenuController">
    <children>
        <!-- Obrázek na pozadí (deska) -->
        <ImageView fitHeight="1000.0" fitWidth="1800.0" pickOnBounds="true">
            <image>
                <Image url="@images/menu-bg.png" />
            </image>
        </ImageView>

        <!-- Tmavý průhledný překryv pro dobrou čitelnost textu -->
        <VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: rgba(18, 18, 20, 0.75);">
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="PANEČKU, ZLOB SE!" textFill="#FFD700">
                            <font>
                                <Font name="System Bold" size="42.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="15.0" maxWidth="300.0">
                    <children>
                        <Button onAction="#spustitHru" prefHeight="48.0" prefWidth="280.0"
                                style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="🎮  Hrát hru" />
                        <Button onAction="#otevritLore" prefHeight="48.0" prefWidth="280.0"
                                style="-fx-background-color: #2e86de; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="📜  Schopnosti postav" />
                        <Button onAction="#ukoncitAplikaci" prefHeight="48.0" prefWidth="280.0"
                                style="-fx-background-color: #3a3b3c; -fx-text-fill: #e4e6eb; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand;" text="🚪  Ukončit hru" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
        </VBox>
    </children>
</StackPane>