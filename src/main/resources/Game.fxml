<?xml version="1.0" encoding="UTF-8"?>

<!--
    Hlavní herní obrazovka aplikace "Panečku, zlob se!"
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1000.0" prefWidth="1600.0"
            style="-fx-background-color: #121214;"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.panacku.zlobse.GameController">

    <!-- HORNÍ LIŠTA -->
    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #1c1c1e; -fx-border-color: #2c2c2e; -fx-border-width: 0 0 1 0;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <children>
                <Button text="← Zpět do Menu"
                        onAction="#zpetDoMenu"
                        prefHeight="32.0"
                        prefWidth="130.0"
                        styleClass="btn-red-fantasy" style="-fx-font-size: 12px;" />
            </children>
        </HBox>
    </top>

    <!-- STŘEDNÍ HRACÍ PLOCHA A OVERLAYE -->
    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>

                <!-- Vrstva 1: Hlavní herní plocha a panel hráčů -->
                <VBox fx:id="gameContent" alignment="CENTER" fillWidth="true">
                    <children>
                        <StackPane>
                            <children>
                                <StackPane prefHeight="800.0" prefWidth="800.0"
                                           maxWidth="800.0" maxHeight="800.0"
                                           StackPane.alignment="CENTER"
                                           style="-fx-background-color: #1c1c1e; -fx-background-radius: 8px;">
                                    <children>
                                        <Pane fx:id="boardContainer" prefWidth="800.0" prefHeight="800.0" />
                                    </children>
                                </StackPane>

                                <VBox fx:id="playersContainer" alignment="TOP_LEFT" spacing="15.0"
                                      prefWidth="320.0" maxWidth="320.0"
                                      prefHeight="800.0" maxHeight="800.0"
                                      StackPane.alignment="CENTER_RIGHT"
                                      style="-fx-background-color: #1c1c1e; -fx-background-radius: 8px; -fx-padding: 20px; -fx-border-color: #2c2c2e; -fx-border-width: 1px;">
                                    <StackPane.margin>
                                        <Insets right="30.0" />
                                    </StackPane.margin>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <!-- Vrstva 2: Výběr herního režimu a hrdinů -->
                <VBox fx:id="selectionContainer" alignment="CENTER" spacing="30.0"
                      style="-fx-background-color: rgba(18, 18, 20, 0.92);">
                    <children>

                        <!-- Výběr počtu hráčů -->
                        <VBox fx:id="modeSelectionBox" alignment="CENTER" spacing="25.0">
                            <children>
                                <Label text="ZVOL REŽIM HRY"
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button text="1v1" onAction="#zvolitRezim2" prefWidth="220.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button text="1v1v1" onAction="#zvolitRezim3" prefWidth="220.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button text="1v1v1v1" onAction="#zvolitRezim4" prefWidth="220.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Výběr hrdinů pro jednotlivé hráče -->
                        <VBox fx:id="heroSelectionBox" alignment="CENTER" spacing="20.0" visible="false">
                            <children>
                                <Label fx:id="selectionTitleLabel" text="Hráč 1: Vyber si svého hrdinu"
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />

                                <!-- První řada hrdinů -->
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="btnRytir" text="Rytíř" onAction="#zvolitRytire" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnCarodejnice" text="Čarodějnice" onAction="#zvolitCarodejnici" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnBandita" text="Bandita" onAction="#zvolitBanditu" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>

                                <!-- Druhá řada hrdinů -->
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="btnNekromant" text="Nekromant" onAction="#zvolitNekromanta" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnElfka" text="Elfka" onAction="#zvolitElfku" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnKralovna" text="Královna" onAction="#zvolitKralovnu" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <!-- Vrstva 3: Overlay pro výběr předmětu z inventáře -->
                <VBox fx:id="itemSelectionOverlay" alignment="CENTER" spacing="25.0" visible="false"
                      style="-fx-background-color: rgba(18, 18, 20, 0.95);">
                    <children>
                        <Label text="POUŽÍT PŘEDMĚT Z INVENTÁŘE"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 28px; -fx-font-weight: bold;" />
                        <HBox fx:id="itemCardsContainer" alignment="CENTER" spacing="25.0" />
                        <Button text="Zrušit" onAction="#zavritVyberPredmetu" prefWidth="120.0" prefHeight="40.0"
                                styleClass="btn-red-fantasy" style="-fx-font-size: 13px;" />
                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>

    <!-- DOLNÍ LIŠTA -->
    <bottom>
        <VBox fx:id="bottomBar" visible="false"
              style="-fx-background-color: #1c1c1e; -fx-border-color: #2c2c2e; -fx-border-width: 1 0 0 0;"
              BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" style="-fx-padding: 10px 0 0 0;">
                    <children>
                        <Label fx:id="statusLabel" text="Na tahu je Hráč 1"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <GridPane>
                    <padding>
                        <Insets top="15" right="30" bottom="15" left="30"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30.0" />
                        <ColumnConstraints percentWidth="40.0" />
                        <ColumnConstraints percentWidth="30.0" />
                    </columnConstraints>
                    <children>
                        <HBox alignment="CENTER_LEFT" GridPane.columnIndex="0">
                            <children>
                                <Button text="Hodit kostkou" onAction="#hoditKostkou" prefWidth="180.0" prefHeight="45.0"
                                        styleClass="btn-red-fantasy" style="-fx-font-size: 13px;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="12.0" GridPane.columnIndex="1">
                            <children>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot1" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot2" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot3" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <Button text="Použít předmět" onAction="#pouzitPredmet" prefHeight="45.0"
                                        styleClass="btn-red-fantasy" style="-fx-font-size: 12px;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" GridPane.columnIndex="2">
                            <children>
                                <Button text="Použít schopnost" onAction="#pouzitSchopnost" prefHeight="45.0"
                                        styleClass="btn-red-fantasy" style="-fx-font-size: 13px;" />
                            </children>
                        </HBox>
                    </children>
                </GridPane>
            </children>
        </VBox>
    </bottom>
</BorderPane>