<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1000.0" prefWidth="1600.0" style="-fx-background-color: #121214;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.panacku.zlobse.GameController">

    <!-- HORNÍ LIŠTA -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1c1c1e; -fx-border-color: #2c2c2e; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <children>
                <Button text="← Zpět do Menu" onAction="#zpetDoMenu" prefHeight="32.0" prefWidth="130.0"
                        style="-fx-background-color: #2c2c2e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
            </children>
        </HBox>
    </top>

    <!-- STŘED: DESKA & OVERLAYE -->
    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>

                <!-- 1. HERNÍ DESKA (Spodní vrstva) -->
                <VBox fx:id="gameContent" alignment="CENTER">
                    <children>
                        <StackPane fx:id="boardContainer" prefHeight="700.0" prefWidth="1200.0" maxWidth="1200.0" maxHeight="700.0"
                                   style="-fx-background-color: #1c1c1e; -fx-background-radius: 8px;">
                        </StackPane>
                    </children>
                    <padding><Insets top="10.0" bottom="10.0" /></padding>
                </VBox>

                <!-- 2. DVOUFÁZOVÝ VÝBĚR (Vrstva NAD deskou) -->
                <VBox fx:id="selectionContainer" alignment="CENTER" spacing="30.0"
                      style="-fx-background-color: rgba(18, 18, 20, 0.92);">
                    <children>

                        <!-- FÁZE 1: VÝBĚR HERNIHO REŽIMU -->
                        <VBox fx:id="modeSelectionBox" alignment="CENTER" spacing="25.0">
                            <children>
                                <Label text="ZVOL REŽIM HRY" style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button text="⚔️ 1 vs 1 (2 hráči)" onAction="#zvolitRezim2" prefWidth="220.0" prefHeight="60.0"
                                                style="-fx-background-color: #2ed573; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 8px; -fx-cursor: hand;" />
                                        <Button text="👑 1v1v1v1 (4 hráči)" onAction="#zvolitRezim4" prefWidth="220.0" prefHeight="60.0"
                                                style="-fx-background-color: #3742fa; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 8px; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- FÁZE 2: POSTUPNÝ VÝBĚR HRDINŮ -->
                        <VBox fx:id="heroSelectionBox" alignment="CENTER" spacing="30.0" visible="false">
                            <children>
                                <Label fx:id="selectionTitleLabel" text="Hráč 1: Vyber si svého hrdinu" style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="btnRytir" text="⚔️ Rytíř" onAction="#zvolitRytire" prefWidth="180.0" prefHeight="60.0"
                                                style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 8px; -fx-cursor: hand;" />
                                        <Button fx:id="btnKouzelnik" text="🔮 Kouzelník" onAction="#zvolitKouzelnika" prefWidth="180.0" prefHeight="60.0"
                                                style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 8px; -fx-cursor: hand;" />
                                        <Button fx:id="btnBandita" text="🗡️ Bandita" onAction="#zvolitBanditu" prefWidth="180.0" prefHeight="60.0"
                                                style="-fx-background-color: #2ed573; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 8px; -fx-cursor: hand;" />
                                        <Button fx:id="btnNekromant" text="💀 Nekromant" onAction="#zvolitNekromanta" prefWidth="180.0" prefHeight="60.0"
                                                style="-fx-background-color: #ffa502; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 8px; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <!-- 3. OVERLAY PRO VÝBĚR PŘEDMĚTU -->
                <VBox fx:id="itemSelectionOverlay" alignment="CENTER" spacing="25.0" visible="false"
                      style="-fx-background-color: rgba(18, 18, 20, 0.95);">
                    <children>
                        <Label text="POUŽÍT PŘEDMĚT Z INVENTÁŘE" style="-fx-text-fill: #FFD700; -fx-font-size: 28px; -fx-font-weight: bold;" />
                        <HBox fx:id="itemCardsContainer" alignment="CENTER" spacing="25.0" />
                        <Button text="Zrušit" onAction="#zavritVyberPredmetu" prefWidth="120.0" prefHeight="40.0"
                                style="-fx-background-color: #2c2c2e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-cursor: hand;" />
                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>

    <!-- DOLNÍ LIŠTA (TLAČÍTKA A INVENTÁŘ) -->
    <bottom>
        <VBox fx:id="bottomBar" visible="false" style="-fx-background-color: #1c1c1e; -fx-border-color: #2c2c2e; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" style="-fx-padding: 10px 0 0 0;">
                    <children>
                        <Label fx:id="statusLabel" text="Na tahu: Hráč 1"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif;" />
                    </children>
                </HBox>

                <GridPane>
                    <padding><Insets top="15" right="30" bottom="15" left="30"/></padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30.0" />
                        <ColumnConstraints percentWidth="40.0" />
                        <ColumnConstraints percentWidth="30.0" />
                    </columnConstraints>
                    <children>
                        <HBox alignment="CENTER_LEFT" GridPane.columnIndex="0">
                            <children>
                                <Button text="🎲 Hodit kostkou" onAction="#hoditKostkou" prefWidth="180.0" prefHeight="45.0"
                                        style="-fx-background-color: #2ed573; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 6px; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="12.0" GridPane.columnIndex="1">
                            <children>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot1" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot2" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot3" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <Button text="🧪 Použít předmět" onAction="#pouzitPredmet" prefHeight="45.0"
                                        style="-fx-background-color: #3742fa; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 6px; -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" GridPane.columnIndex="2">
                            <children>
                                <Button text="⚡ Použít schopnost" onAction="#pouzitSchopnost" prefHeight="45.0"
                                        style="-fx-background-color: #ff4757; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', sans-serif; -fx-background-radius: 6px; -fx-cursor: hand;" />
                            </children>
                        </HBox>
                    </children>
                </GridPane>
            </children>
        </VBox>
    </bottom>
</BorderPane>